{
	"name": "@prismicio/mcp-server",
	"version": "0.0.20",
	"description": "Prismic Model Context Protocol (MCP) Server",
	"keywords": [
		"model context protocol",
		"mcp",
		"typescript",
		"prismic"
	],
	"repository": {
		"type": "git",
		"url": "ssh://git@github.com/prismicio/prismic-mcp-server.git"
	},
	"license": "Apache-2.0",
	"author": "Prismic <contact@prismic.io> (https://prismic.io)",
	"type": "module",
	"exports": {
		".": {
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.cjs"
			},
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./stdio": {
			"require": {
				"types": "./dist/stdio.d.ts",
				"default": "./dist/stdio.cjs"
			},
			"import": {
				"types": "./dist/stdio.d.ts",
				"default": "./dist/stdio.js"
			}
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"stdio": "./bin/stdio.js"
	},
	"files": [
		"./dist",
		"./src"
	],
	"scripts": {
		"build": "vite build",
		"dev": "vite build --watch",
		"preview": "npx @modelcontextprotocol/inspector node bin/stdio",
		"format": "prettier --write .",
		"prepare": "npm run build",
		"lint": "eslint",
		"types": "vitest --typecheck.only --run",
		"types:watch": "vitest --typecheck.only",
		"size": "size-limit",
		"test": "npm run lint && npm run types && npm run build && npm run size",
		"test:e2e": "playwright test --config __tests__/e2e/playwright.config.ts",
		"test:e2e:update": "npm run test:e2e -- --update-snapshots",
		"test:e2e:merge-reports": "playwright merge-reports"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.29.0",
		"@prismicio/client": "7.21.8",
		"@prismicio/mocks": "2.15.2",
		"@prismicio/types-internal": "3.17.0",
		"@segment/analytics-node": "3.0.0",
		"@sentry/node": "10.47.0",
		"common-tags": "1.8.2",
		"cookie": "1.1.1",
		"prettier": "3.8.1",
		"prismic-ts-codegen": "0.1.29",
		"zod": "4.3.6",
		"@slicemachine/manager": "0.27.2",
		"uuid": "13.0.0"
	},
	"devDependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.2.92",
		"@anthropic-ai/claude-code": "^2.1.92",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.59.1",
		"@size-limit/preset-small-lib": "^12.0.1",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/common-tags": "1.8.4",
		"@types/node": "^25.5.2",
		"@vitest/coverage-v8": "^4.1.2",
		"dotenv": "^17.4.1",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-tsdoc": "^0.5.2",
		"giget": "^3.2.0",
		"prettier": "^3.8.1",
		"prettier-plugin-jsdoc": "^1.8.0",
		"size-limit": "^12.0.1",
		"standard-version": "^9.5.0",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.58.0",
		"vite": "^7.3.2",
		"vite-plugin-sdk": "^0.1.5",
		"vitest": "^4.1.2"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
